# =============================================================================
# migraine-chatbot — environment template
# Copy to .env and adjust. See docs/environment-variables.md for full reference.
# =============================================================================

# --- Required ----------------------------------------------------------------

OPENAI_API_KEY=

# Override in production (min 32 random bytes).
JWT_SECRET=change-me

DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/chatbot

# --- Core application --------------------------------------------------------

ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8043
BACKEND_PORT=8043
FRONTEND_PORT=3043

# Run alembic on container start. Set to 1 only if migrations run elsewhere.
SKIP_DB_MIGRATIONS=0

# --- Postgres (Compose service init) -----------------------------------------

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chatbot
POSTGRES_PORT=5432

# --- Qdrant ------------------------------------------------------------------

# Inside Compose network use host `qdrant` and port 6333.
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_HTTP_PORT=6043
QDRANT_GRPC_PORT=6044

# Legacy single-tenant scheduler only (requires SCHEDULER_LEGACY_GLOBAL=true).
# COLLECTION_NAME=

# --- Auth --------------------------------------------------------------------

JWT_EXPIRES_MINUTES=120

# --- Admin API CORS ----------------------------------------------------------

CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# --- Chat retrieval limits ---------------------------------------------------
# Tenant rows can override within these bounds (see tenants.chat_max_results*).

CHAT_MAX_RESULTS_ABSOLUTE_CEILING=50
CHAT_MAX_RESULTS_DEFAULT_GENERAL=5
CHAT_MAX_RESULTS_DEFAULT_CATALOG=8

# --- Dialogue engine (branch-specific) -----------------------------------------
# Base branch (feature/conversational-phase-6): orchestrator only — see below.
# pivot/RAG-first: DIALOGUE_ENGINE=semantic — backend/dialogue/ semantic stack.
# feature/rasa-dialogue-engine: DIALOGUE_ENGINE=rasa — see rasa pivot docs.
#
# orchestrator = run_query_understanding + merge_session_query (base hot path)
# semantic     = Python RAG NLU + policy (docs/semantic-nlu-dst-pivot/)
# rasa         = Rasa NLU + custom actions (docs/rasa-dialogue-pivot/)

DIALOGUE_ENGINE=orchestrator
RASA_URL=http://rasa:5005
RASA_ACTIONS_URL=http://rasa-actions:5055

# pivot/RAG-first — uncomment when semantic_bridge is wired (Phase 2+):
# DIALOGUE_ENGINE=semantic
# INTENT_EXAMPLES_COLLECTION=intent_examples_v1

# Staged debugging — semantic_bridge (pivot/RAG-first) or rasa_bridge (rasa branch).
# Empty = full user response (production path).
# nlu    = intent, entities, confidence, intent_candidates[] only (no Qdrant product search)
# policy = DST: policy_action, merge_action, session_context, pending_clarification (no search)
# query  = StructuredQuery + RetrievalPlan after merge (optional skip search)
DIALOGUE_DEBUG=
# When true, run full dialogue pipeline but return meta.debug_stages instead of product cards.
DIALOGUE_DRY_RUN=false

# --- Query understanding (orchestrator path; legacy when DIALOGUE_ENGINE=orchestrator) ---
# hybrid = rules prepass + LLM extraction with timeout fallback to rules only.

QUERY_UNDERSTANDING_MODE=hybrid
QUERY_UNDERSTANDING_LLM_MODEL=gpt-4o-mini
QUERY_UNDERSTANDING_LLM_TIMEOUT_MS=2500
QUERY_UNDERSTANDING_SKIP_LLM_WHEN_COMPLETE=true

# Include structured_query + retrieval_trace on chat_embedding usage_events (local debugging).
# Trace has session_query, turn_after_qu, merged, merge_action, plan.filters, hit_count, etc.
# Inspect with psql: usage_events.meta_json->'retrieval_trace' (join on session_id; see project docs).
RETRIEVAL_DEBUG_QUERY=false

# When true, NL category at gazetteer confidence uses hard Qdrant filter (not hint).
RETRIEVAL_CATEGORY_FILTER_ON_GAZETTEER=false
# When true (default), apply Qdrant categories filter only for gazetteer entries with hard_filter: true.
RETRIEVAL_CATEGORY_HARD_FILTER_ENABLED=true
# Deprecated alias for RETRIEVAL_CATEGORY_HARD_FILTER_ENABLED:
RETRIEVAL_CATEGORY_FILTER_ON_PRODUCT_TYPE=true

# --- Retrieval hybrid rank (Phase 3b) ----------------------------------------
# Requires full reindex per tenant (recreates Qdrant collection with dense+sparse).

RETRIEVAL_HYBRID_ENABLED=true
RETRIEVAL_HYBRID_MIN_PRODUCTS=10
RETRIEVAL_HYBRID_RRF_K=60
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# --- Retrieval tiered search & scoring (Phase 2b) ----------------------------

RETRIEVAL_TIER_MIN_RESULTS=1
RETRIEVAL_TIER_RELAXATION_ENABLED=true
RETRIEVAL_SEARCH_LIMIT_MULTIPLIER=5
RETRIEVAL_SCORE_THRESHOLD_DEFAULT=0.3
RETRIEVAL_SCORE_THRESHOLD_FILTERED=0.25
RETRIEVAL_SCORE_THRESHOLD_RELAXED_DELTA=0.05
RETRIEVAL_CATALOG_SKIP_PREPROCESS=true

# --- Facet profile at reindex (Phase 1) --------------------------------------
# Values are stored on tenants.retrieval_profile_json after catalog reindex.

RETRIEVAL_FACET_MIN_COVERAGE_PCT=5
RETRIEVAL_CATEGORY_CONFIDENCE_THRESHOLD=0.75
RETRIEVAL_FACET_MAX_SAMPLE_VALUES=20

# --- Embedding & reindex pipeline --------------------------------------------

EMBEDDING_BATCH_SIZE=10
EMBEDDING_CHUNK_SIZE=50
INDEXING_RECORD_CONCURRENCY=5
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_DELAY=1.0
EMBEDDING_RATE_LIMIT_DELAY=0.1
REINDEX_PROGRESS_COMMIT_INTERVAL_SECONDS=2
REINDEX_PROGRESS_EMIT_INTERVAL_SECONDS=1

# --- Scheduler (optional background reindex) ---------------------------------

SCHEDULER_DISABLED=false
SCHEDULER_LEGACY_GLOBAL=false
SCHEDULER_RUN_ON_START=0

# --- Frontend / widget runtime URLs ------------------------------------------
# REACT_APP_API_URL is baked at frontend image build time.

REACT_APP_API_URL=http://localhost:8043
WIDGET_BASE_URL=
PUBLIC_API_BASE_URL=

# --- Public widget auth & origin policy --------------------------------------

# JSON map: {"embed_key_uuid":"tenant_uuid", ...}
WIDGET_EMBED_KEYS_JSON={}
WIDGET_REQUIRE_ORIGIN=false
WIDGET_ALLOWED_ORIGINS=*

# --- GeoIP (optional country blocks) -----------------------------------------
# docker compose mounts ./data/geoip -> /data/geoip (read-only)
# python3 backend/scripts/download_dbip_country_lite.py -o data/geoip/dbip-country-lite.mmdb

GEOIP_DB_PATH=

# --- Tenant assets (avatars) -------------------------------------------------
# Compose sets TENANT_ASSETS_DIR=/data/tenant-assets via named volume.

# TENANT_ASSETS_DIR=/tmp/tenant-assets

# --- Bootstrap superadmin (first migration only) -----------------------------
# Or: docker compose run --rm backend python scripts/create_superadmin.py ...

BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@example.com
BOOTSTRAP_SUPERADMIN_PASSWORD_HASH=

# --- CLI helpers (optional) --------------------------------------------------

# REINDEX_BEARER_TOKEN=
# BEARER_TOKEN=

# --- WordPress source fallbacks (optional) -----------------------------------
# Used only when a tenant has no source_db_url in DB. Prefer per-tenant DSN.

WORDPRESS_DB_HOST=
WORDPRESS_DB_PORT=3306
WORDPRESS_DB_USER=
WORDPRESS_DB_PASSWORD=
WORDPRESS_DB_NAME=
WORDPRESS_URL_TABLE=wp_custom_urls
WORDPRESS_TABLE_PREFIX=wp_
